# ============================================================
# Marketly Backend — Environment Variables
# Copy to .env and fill in real values before running.
# .env is gitignored — NEVER commit secrets to version control.
# ============================================================

# ── PostgreSQL ────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=marketly
DB_USERNAME=marketly
DB_PASSWORD=marketly_dev

# ── Redis ─────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Kafka ─────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ── JWT ───────────────────────────────────────────────────────
# Min 256 bits (32+ characters). Change in staging/production.
JWT_SECRET=dev-secret-key-change-this-in-production-min-256-bits-!!
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=7

# ── Eureka Service Discovery ──────────────────────────────────
EUREKA_SERVER_URL=http://localhost:8761/eureka

# ── Email (SMTP) ──────────────────────────────────────────────
# For local dev: use Mailtrap (https://mailtrap.io) — free fake inbox
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=noreply@marketly.in

# ── Spring Profile ────────────────────────────────────────────
# local | staging | production
SPRING_PROFILES_ACTIVE=local
